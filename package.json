{
  "name": "oqunet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OquNet — Book sharing community (MVP)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node scripts/seed.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-oqunet-rules 'node --test tests/firestore.rules.test.js'",
    "test:data": "node --import ./tests/helpers/register.mjs --test tests/dataLayer.test.mjs tests/installNotification.test.mjs tests/chat.test.mjs tests/rateLimit.test.mjs tests/analytics.test.mjs",
    "test:queries": "firebase emulators:exec --only firestore --project demo-oqunet-idx 'node --test tests/queries.emulator.test.mjs'",
    "test": "npm run test:data && npm run test:queries && npm run test:rules"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "firebase": "^10.12.0",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.2.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0"
  }
}
