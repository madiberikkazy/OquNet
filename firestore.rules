rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// OquNet — Firestore authorization.
//
// Deny by default. There is no catch-all allow; a collection that is not
// matched below is unreachable from any client.
//
// The model, in one paragraph. A user document (id == the Firebase Auth uid)
// carries `role` ("user" | "admin") and `communityId` — a single string, since
// a person belongs to exactly one community at a time. `role: "admin"` is a
// global field whose *effective scope* is that same `communityId`: an admin has
// power over their own community and nowhere else. The `memberIds` array on a
// community document is written once at creation and never maintained, so it is
// NOT a membership source of truth and is deliberately not consulted here.
//
// ── SCALABILITY: get() is a billed read ──────────────────────────────────────
// Resolving the caller's role means reading their user document, and every
// get()/exists() in a rule is a document read *billed to the request*. A single
// rule evaluation is also hard-capped at 10 such calls. Identical paths are
// cached within one evaluation, so `me()` costs exactly one read per request no
// matter how many helpers below call it — but it is still one extra read on top
// of every single write, and on most reads.
//
// The scalable fix is Firebase Auth **custom claims**: mint `role` and
// `communityId` into the user's ID token and read them here as
// `request.auth.token.role` / `request.auth.token.communityId`, which is free
// and uncapped. That requires an Admin SDK backend (a Cloud Function or a
// server) to call setCustomUserClaims() whenever a role or a membership
// changes, plus a token refresh on the client — which this project does not
// have yet. Roles are therefore read from Firestore for now. Before adding any
// new get() call site, check it against the 10-call budget.
//
// ── Known limits, stated rather than papered over ────────────────────────────
//  1. `borrowings` and `ratings` are readable by any signed-in user. Rules can
//     only allow or deny a query, never filter it, and the app queries both by
//     bookId alone (getActiveBorrowingByBook, listRatingsForBook) with no
//     community filter — so a community-scoped read rule would reject those
//     queries outright. Scoping them needs a `communityId` field on both
//     document types plus matching query changes.
//  2. A borrowing carries `pickupCode`. That code is *already* read into the
//     requesting user's browser and compared client-side (PickupBook.jsx), so
//     it is a handshake, not a secret. Making it one needs a server.
//  3. `users` is globally readable to signed-in callers: Home search,
//     UserProfile and the admin invite picker all look up people outside the
//     caller's community.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ Identity ═══

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSelf(userId) { return signedIn() && uid() == userId; }

    // The caller's own profile. One billed read per request — see the note above.
    function me() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    function myCommunity() { return me().communityId; }

    function isMemberOf(cid) {
      return signedIn() && cid != null && myCommunity() == cid;
    }
    function isAdminOf(cid) {
      return signedIn() && cid != null
        && me().role == 'admin' && me().communityId == cid;
    }

    // An approved join request, named by id, belonging to the caller and to the
    // community they are naming.
    //
    // Two writes turn on this and they are deliberately the same check: the new
    // member's own membership, and the book they promised in the application.
    // Both are writes the applicant makes for themselves, and the request is the
    // only thing that says an admin agreed to either.
    function approvedJoinFor(requestId, cid) {
      return exists(/databases/$(database)/documents/requests/$(requestId))
        && joinRequestOf(requestId).userId == uid()
        && joinRequestOf(requestId).communityId == cid
        && joinRequestOf(requestId).type == 'join'
        && joinRequestOf(requestId).status == 'approved';
    }
    function joinRequestOf(requestId) {
      return get(/databases/$(database)/documents/requests/$(requestId)).data;
    }

    // ═══ Diff helpers (update rules only — `resource` is null on create) ═══

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function frozen(fields) { return !changed().hasAny(fields); }
    function touchesOnly(fields) { return changed().hasOnly(fields); }

    // ═══ users ═══
    //
    // A profile is created by its owner at registration, and from then on only
    // its owner may write it — with two carve-outs the app genuinely needs:
    // founding a community (self-promotion to admin, tightly constrained) and a
    // community admin ejecting a member.

    match /users/{userId} {
      allow get, list: if signedIn();

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasAll(
             ['email', 'nickname', 'role', 'communityId', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.nickname is string
        // Nobody registers as an admin, and nobody registers into a community.
        && request.resource.data.role == 'user'
        && request.resource.data.communityId == null
        && request.resource.data.createdAt == request.time
        // Mock-mode-only field; it must never reach a real database.
        && !('password' in request.resource.data);

      // The follower rollup is tried first, and cheaply: it exits at `!isSelf`
      // for any write to your own profile, so a self-update pays nothing for
      // it. Ordering it ahead of the other two also keeps a legitimate counter
      // write independent of how they evaluate — in this language a branch that
      // errors takes the whole statement down with it, and denying somebody's
      // follow because of a rule about email addresses would be a very hard
      // failure to explain.
      allow update: if followerRollup(userId)
        || selfUpdate(userId) || adminEjectsMember(userId);
      allow delete: if false;
    }

    // A follow, counted on the profile that was followed.
    //
    // `followersCount` is the one field on a profile a *stranger* may move, so
    // the authorisation is the edge itself: follows/$(uid())__$(userId) must
    // exist for a +1 and must be gone for a −1. That is why the data layer
    // always writes the edge first and the counter second (see followUser /
    // unfollowUser) — the counter write is only ever the summary catching up
    // with a fact the caller was independently allowed to write.
    //
    // The reader's own `followingCount` needs no rule of its own: it lives on
    // their own profile and rides in on `selfUpdate`, exactly like
    // `likedPostIds`, whose counterpart `likeCount` this whole arrangement
    // mirrors.
    //
    // One exists() per write, and only on this branch — a self-update never
    // reaches it. See the get() budget note at the top of the file.
    function followerRollup(userId) {
      return signedIn()
        && !isSelf(userId)
        && touchesOnly(['followersCount'].toSet())
        && request.resource.data.followersCount is int
        && request.resource.data.followersCount >= 0
        && ((request.resource.data.followersCount == resource.data.get('followersCount', 0) + 1
             && followEdge(userId))
            || (request.resource.data.followersCount == resource.data.get('followersCount', 0) - 1
                && !followEdge(userId)));
    }

    function followEdge(userId) {
      return exists(/databases/$(database)/documents/follows/$(uid() + '__' + userId));
    }

    function selfUpdate(userId) {
      return isSelf(userId)
        && frozen(['createdAt', 'id'].toSet())
        && emailMatchesAccount()
        && !('password' in request.resource.data)
        && roleChangeAllowed()
        && membershipChangeAllowed()
        && phoneChangeAllowed();
    }

    /**
     * A phone number is only worth as much as whoever proved it — and that is
     * no longer anybody a rule can see.
     *
     * This is the one field on a profile that a stranger acts on physically:
     * the pickup and return screens hand it to somebody who is about to travel
     * to meet its owner. It used to be proven by SMS, and Firebase Auth put the
     * proven number into the caller's own ID token, so this rule could compare
     * the two. That is gone: verification now happens in a Telegram
     * conversation with our bot, and the only party that learns which number a
     * shared contact card carries is the bot's server.
     *
     * So the rule is the strongest one available: **no client may set a phone
     * number, ever**. The write belongs to the webhook, through the Admin SDK,
     * which does not pass through here at all (server/server.js). A client
     * that could write it would make the whole handshake decorative — it is a
     * number somebody else has to be able to trust.
     *
     * Clearing stays allowed, and only as a pair: `deleteAccount` scrubs the
     * profile from the client, removing a number claims nothing, and a timestamp
     * left behind on an empty number is a profile saying it proved something it
     * does not have.
     */
    function phoneChangeAllowed() {
      return !changed().hasAny(['phone', 'phoneVerifiedAt'].toSet())
        || (request.resource.data.get('phone', '') == ''
            && request.resource.data.get('phoneVerifiedAt', null) == null);
    }

    // The profile may only ever repeat what Firebase Auth already says.
    //
    // An email change happens in Auth first: the app calls
    // verifyBeforeUpdateEmail, the user confirms from the new inbox, and only
    // then does the account's email actually move. This write is the profile
    // catching up afterwards, so the value has to equal the caller's own token
    // claim — which exists only because Auth issued it. Typing a new address
    // into the profile and saving it is still refused, exactly as before.
    function emailMatchesAccount() {
      return frozen(['email'].toSet())
        || request.resource.data.email == request.auth.token.email;
    }

    // Self-promotion is allowed for exactly one reason: you just founded a
    // community. The same write must move you into a community whose ownerId is
    // you — and a `communities` create already required that to be the caller.
    // Standing back down to "user" is always allowed.
    function roleChangeAllowed() {
      return frozen(['role'].toSet())
        || request.resource.data.role == 'user'
        || (request.resource.data.role == 'admin'
            && ownsCommunity(request.resource.data.communityId));
    }

    // Membership moves in exactly three ways: you leave (→ null), you found a
    // community you own, or an admin approved your join request. The last one
    // is verifiable only because the write carries `joinRequestId` — without
    // it, a rule has no way to name the request it should be checking.
    function membershipChangeAllowed() {
      return frozen(['communityId'].toSet())
        || request.resource.data.communityId == null
        || ownsCommunity(request.resource.data.communityId)
        || joinWasApproved(request.resource.data.communityId);
    }

    function ownsCommunity(cid) {
      return cid != null
        && exists(/databases/$(database)/documents/communities/$(cid))
        && get(/databases/$(database)/documents/communities/$(cid)).data.ownerId == uid();
    }

    function joinWasApproved(cid) {
      return 'joinRequestId' in request.resource.data
        && approvedJoinFor(request.resource.data.joinRequestId, cid);
    }

    // Removing someone from your community — and nothing else about them.
    function adminEjectsMember(userId) {
      return !isSelf(userId)
        && isAdminOf(resource.data.communityId)
        && touchesOnly(['communityId'].toSet())
        && request.resource.data.communityId == null;
    }

    // ═══ usernames ═══
    //
    // A public nickname → account index, holding ONLY { uid, email }. It is
    // readable while signed out on purpose: login-by-nickname has to resolve an
    // email *before* it can authenticate, and registration has to check
    // availability. Keeping that lookup here rather than on `users` is what
    // lets the profile itself — phone, address, saved books — stay behind auth.
    //
    // `list` is denied so the index cannot be dumped; only a direct lookup of a
    // nickname you already know works. A rename is a delete plus a create.

    match /usernames/{nickname} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && request.resource.data.email is string;

      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ═══ follows ═══
    //
    // One document per "A follows B", at the id `A__B` — ordered, because
    // following is not symmetric and both directions have to be able to exist
    // at once. Everything here is read out of the *path*, the same trick the
    // chats rules use: only `$(uid())__$(somebody)` is writable, so an edge
    // claiming that somebody else follows you cannot be created at all, and
    // proving that costs no document read.
    //
    // Readable to any signed-in caller, like `users` itself: a followers list
    // is a public thing on a profile, and it holds nothing that is not already
    // two account ids side by side.

    function followPair(followId) { return followId.split('__'); }

    match /follows/{followId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && followPair(followId).size() == 2
        && followPair(followId)[0] == uid()
        && followPair(followId)[1] != uid()
        && request.resource.data.keys().hasOnly(['id', 'followerId', 'followingId', 'createdAt'])
        && request.resource.data.id == followId
        && request.resource.data.followerId == uid()
        && request.resource.data.followingId == followPair(followId)[1]
        && request.resource.data.createdAt == request.time;

      // An edge is created or deleted, never edited — there is nothing in it to
      // change that would not make it a different edge.
      allow update: if false;
      allow delete: if signedIn() && followPair(followId)[0] == uid();
    }

    // ═══ communities ═══
    //
    // Globally readable: browsing a community you are not yet in is the whole
    // point of the discovery screen.

    match /communities/{communityId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.nickname is string
        && request.resource.data.name is string
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && resource.data.ownerId == uid()
        && frozen(['ownerId', 'createdAt'].toSet());

      allow delete: if false;
    }

    // ═══ books ═══
    //
    // Two people are attached to a book and they are not the same thing:
    // `ownerId` is who it belongs to, `holderId` is who physically has it now.
    // `communityId` is frozen for everyone including admins — a book cannot
    // migrate between communities. `ownerId` moves only by a community admin's
    // deliberate correction (reassignBookOwner), never as a side effect of a
    // handoff: the two lanes that handle handoffs cannot write it at all.

    match /books/{bookId} {
      allow get, list: if signedIn()
        && resource.data.communityId == myCommunity();

      allow create: if (isAdminOf(request.resource.data.communityId)
                        || joinerBringsTheirBook())
        && request.resource.data.keys().hasAll(
             ['name', 'author', 'communityId', 'ownerId',
              'holderId', 'status', 'genre', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.ownerId is string
        && request.resource.data.genre is string
        // A new book has never been handed over, so it starts with its owner.
        && request.resource.data.holderId == request.resource.data.ownerId
        && request.resource.data.status == 'available'
        && request.resource.data.createdAt == request.time;

      allow update: if bookAdminEdit() || bookRatingRollup() || bookHandoff();

      // The owner deletes their own copies on the way out of the community
      // (LeaveCommunity); the admin curates the shelf (AdminBooks).
      allow delete: if isAdminOf(resource.data.communityId)
        || (isMemberOf(resource.data.communityId) && resource.data.ownerId == uid());
    }

    // The entry fee, paid at the moment it is owed.
    //
    // Joining costs a book, and the admin approved a specific one — but the
    // book must not exist before the applicant has said yes, or a shelf ends up
    // holding books belonging to people who never joined. So the applicant
    // creates it themselves, in the same breath as their membership, and this
    // is what makes that safe: the book is theirs (`ownerId`), it names the
    // application it came in with, and that application has to be an approved
    // join of theirs into this very community. Everything else about the
    // document is held to the same checks an admin's book is held to.
    function joinerBringsTheirBook() {
      return signedIn()
        && request.resource.data.ownerId == uid()
        && 'joinRequestId' in request.resource.data
        && approvedJoinFor(request.resource.data.joinRequestId,
                           request.resource.data.communityId);
    }

    function bookAdminEdit() {
      return isAdminOf(resource.data.communityId)
        && frozen(['communityId', 'createdAt'].toSet());
    }

    // recalcBookRating: whoever just rated the book refreshes its denormalised
    // aggregate. Nothing else on the document may move in the same write.
    function bookRatingRollup() {
      return isMemberOf(resource.data.communityId)
        && touchesOnly(['rating', 'ratingSum', 'ratingCount'].toSet())
        && request.resource.data.rating is number
        && request.resource.data.ratingSum is number
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 0;
    }

    // The only transitions the app makes. Note what is missing from the key
    // set: `ownerId` cannot ride along on a handoff even by accident.
    function bookHandoff() {
      return isMemberOf(resource.data.communityId)
        && touchesOnly(['status', 'borrowerId', 'holderId'].toSet())
        && (takesBook() || releasesBook() || sendsBookHome()
            || reservesForReturn() || releasesReservation() || ownerReclaims());
    }

    // Mirrors utils/bookHolder.js — a book with no holderId is with its owner.
    function currentHolder() {
      return resource.data.get('holderId', resource.data.ownerId);
    }

    // transferBookHolder — the caller collects the copy and becomes its reader.
    function takesBook() {
      return request.resource.data.status == 'unavailable'
        && request.resource.data.holderId == uid()
        && request.resource.data.borrowerId == uid();
    }

    // releaseBookAfterReading — finished, but the copy stays on the caller's
    // own shelf until somebody comes to collect it.
    function releasesBook() {
      return currentHolder() == uid()
        && request.resource.data.status == 'available'
        && request.resource.data.borrowerId == null
        && request.resource.data.holderId == uid();
    }

    // returnBookToOwner — the holder sends the copy home. The owner is the one
    // destination that never needs a code.
    function sendsBookHome() {
      return currentHolder() == uid()
        && request.resource.data.status == 'available'
        && request.resource.data.borrowerId == null
        && request.resource.data.holderId == resource.data.ownerId;
    }

    // ── The owner's three lanes: asking for their own copy back ──────────────
    //
    // These exist for the member on their way out of a community, who cannot
    // leave while a book of theirs is with somebody else (utils/communityExit.js)
    // and so must be able to get it back without depending on that person to
    // press a button.
    //
    // All three are the owner acting on their own book, and none of them can
    // hand it to a third party: two write `holderId` not at all, and the one
    // that does can only write the caller's own uid — which for these lanes is
    // by definition the owner.

    // reserveBookForReturn — the copy comes off the shelf while its owner
    // arranges to collect it, so nobody starts a pickup on a book that is
    // already on its way home. The holder does not change: they still have it.
    // `borrowerId` stays null, and that is what distinguishes this from a loan.
    function reservesForReturn() {
      return resource.data.ownerId == uid()
        // Only a copy that is somewhere else. An owner holding their own book
        // has nothing to collect, and marking it occupied would only hide a
        // book the community is owed from the shelf.
        && currentHolder() != uid()
        && resource.data.status == 'available'
        && request.resource.data.status == 'unavailable'
        && request.resource.data.borrowerId == null
        && frozen(['holderId'].toSet());
    }

    // releaseBookReservation — the mirror image: the return was cancelled or
    // lapsed after three days, so the copy goes back on the shelf. Only a book
    // nobody is reading can be freed this way; `borrowerId == null` on the
    // *stored* document is what says the reservation was a reservation and not
    // somebody's live loan.
    function releasesReservation() {
      return resource.data.ownerId == uid()
        && resource.data.borrowerId == null
        && request.resource.data.status == 'available'
        && request.resource.data.borrowerId == null
        && frozen(['holderId'].toSet());
    }

    // completeReturnToOwner — the handover happened and the copy is back in its
    // owner's hands. Deliberately not conditional on a request document: an
    // owner is entitled to their own book, the four-digit code is a handshake
    // between two people rather than an authorisation the server can check
    // (see limit 2 at the top of this file), and the exit rules oblige them to
    // collect every copy before they may leave.
    function ownerReclaims() {
      return resource.data.ownerId == uid()
        && request.resource.data.status == 'available'
        && request.resource.data.borrowerId == null
        && request.resource.data.holderId == uid();
    }

    // ═══ borrowings ═══
    //
    // Read access is sign-in only; see limit (1) at the top of this file.

    match /borrowings/{borrowingId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.borrowerId == uid()
        && request.resource.data.status == 'active'
        && request.resource.data.bookId is string;

      // The borrower drives their own loan. The other two lanes exist because
      // the *incoming* reader is the one who closes the previous loan
      // (transferBookHolder) and who stamps a fresh handoff code (PickupBook).
      allow update: if signedIn()
        && frozen(['bookId', 'borrowerId', 'ownerId', 'createdAt'].toSet())
        && (
             resource.data.borrowerId == uid()
          || (touchesOnly(['status', 'returnDate'].toSet())
              && request.resource.data.status == 'completed')
          || touchesOnly(['pickupCode'].toSet())
        );

      allow delete: if false;
    }

    // ═══ ratings ═══
    //
    // One document per (book, user), and the document id says so — which is
    // what makes "has this person already rated?" a point read and a second
    // rating an overwrite rather than a second vote. Read access is sign-in
    // only; see limit (1) at the top of this file.

    match /ratings/{ratingId} {
      allow get, list: if signedIn();

      allow create, update: if signedIn()
        && ratingId == request.resource.data.bookId + '__' + uid()
        && request.resource.data.userId == uid()
        && request.resource.data.bookId is string
        && request.resource.data.value is int
        && request.resource.data.value >= 1
        && request.resource.data.value <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() <= 2000;

      // Ratings written before the deterministic-id scheme live under random
      // ids; submitRating collapses them so a person is counted exactly once.
      allow delete: if signedIn() && resource.data.userId == uid();
    }

    // ═══ readingSessions ═══
    //
    // One immutable row per finished run of the reading timer, and the durable
    // log the `readingDays` map on a profile is folded from.
    //
    // Strictly author-only to read, which is narrower than it looks: the grid
    // other members see on somebody's profile is drawn from that folded map on
    // the `users` document, which is already readable. Nothing needs to read
    // these rows except the person who wrote them, so nothing may.
    //
    // Update and delete are denied outright. A log whose past can be edited
    // cannot be used to recompute the aggregate it backs — which is the only
    // reason to keep the rows at all.

    match /readingSessions/{sessionId} {
      allow get, list: if signedIn() && resource.data.userId == uid();

      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.dayKey is string
        && request.resource.data.seconds is int
        // Mirrors MIN_SESSION_SECONDS in utils/readingProgress.js: below half a
        // minute a "session" is a mis-tap, not reading.
        && request.resource.data.seconds >= 30
        // And MAX_SESSION_SECONDS. A sitting longer than ten hours is a stuck
        // timer, not a reader.
        && request.resource.data.seconds <= 36000
        && request.resource.data.startedAt is number
        && request.resource.data.endedAt is number
        && request.resource.data.startedAt <= request.resource.data.endedAt
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // ═══ requests ═══
    //
    // Join, leave, pickup and return requests share one collection,
    // discriminated by `type`. Join and leave name their subject in `userId`;
    // pickup names it in `requesterId` and carries no communityId at all.
    //
    // A return names `requesterId` (the book's owner, collecting it) and does
    // carry `communityId`, because it is the one request type a *third* party
    // has to be able to look up: before offering to collect a book, the pickup
    // screen asks whether its owner is already on the way to fetch it. That
    // makes its `returnCode` readable by the community, which is the same
    // handshake-not-secret it already was on a borrowing — see limit (2).

    match /requests/{requestId} {
      allow get: if signedIn() && (
           resource.data.get('userId', '') == uid()
        || resource.data.get('requesterId', '') == uid()
        || isAdminOf(resource.data.get('communityId', ''))
      );

      // Written as bare field comparisons rather than helper calls: a `list`
      // rule is checked against the *query*, so each disjunct has to be
      // something a where-clause can satisfy.
      allow list: if signedIn() && (
           resource.data.communityId == myCommunity()
        || resource.data.userId == uid()
        || resource.data.requesterId == uid()
      );

      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && (
             (request.resource.data.type == 'pickup'
              && request.resource.data.requesterId == uid()
              && request.resource.data.bookId is string)
             // A return is a pickup run backwards — the owner of a book asking
             // whoever has it to bring it home. It names the community as well
             // as the book, because the pickup screen has to be able to ask
             // "is this copy already on its way home?", and a `list` rule can
             // only accept a query it can scope.
          || (request.resource.data.type == 'return'
              && request.resource.data.get('openedBy', 'owner') == 'owner'
              && request.resource.data.requesterId == uid()
              && request.resource.data.bookId is string
              && request.resource.data.holderId is string
              && request.resource.data.holderId != uid()
              && request.resource.data.communityId == myCommunity())
             // The same handover offered from the other end: the holder saying
             // "come and get it". One document, one shape — `requesterId` is
             // still the person collecting, so everything downstream cannot
             // tell which end opened it.
             //
             // Both parties are read off the book rather than taken on the
             // caller's word, and neither check is optional. Without the owner
             // check a holder could name anybody as the collector — a code and
             // a notification sent to a stranger about somebody else's book.
             // Without the holder check any member could open a return on any
             // book in the community, and since an open return blocks every
             // pickup on that copy, that is a way to freeze any book on the
             // shelf for three days. The two `get()`s are the same path, which
             // the rules engine caches, so this costs one read.
          || (request.resource.data.type == 'return'
              && request.resource.data.openedBy == 'holder'
              && request.resource.data.bookId is string
              && request.resource.data.holderId == uid()
              && request.resource.data.requesterId != uid()
              && request.resource.data.requesterId == bookOf(request.resource.data.bookId).ownerId
              && uid() == holderOfBook(request.resource.data.bookId)
              && request.resource.data.communityId == myCommunity())
          || ((request.resource.data.type == 'join'
               || request.resource.data.type == 'leave')
              && request.resource.data.userId == uid()
              && request.resource.data.communityId is string)
        );

      // The subject cancels or drives their own request; the community admin
      // decides it. Neither may re-point it at someone else.
      allow update: if signedIn()
        && frozen(['type', 'userId', 'requesterId', 'communityId', 'bookId'].toSet())
        && (
             isAdminOf(resource.data.get('communityId', ''))
          || (requestSubject() && !decidesOwnRequest())
        );

      function bookOf(bookId) {
        return get(/databases/$(database)/documents/books/$(bookId)).data;
      }

      // Mirrors utils/bookHolder.js, same as `currentHolder()` on books: a book
      // with no holderId is with its owner.
      function holderOfBook(bookId) {
        return bookOf(bookId).get('holderId', bookOf(bookId).ownerId);
      }

      function requestSubject() {
        return resource.data.get('userId', '') == uid()
            || resource.data.get('requesterId', '') == uid()
            // A return has two parties, and the holder is the other one — but
            // only over an offer they made themselves. An owner asking for
            // their own property back is not something the person holding it
            // gets to cancel; that request is the owner's, and the exit rules
            // depend on it staying open until the book actually comes home.
            // `openedBy` is the field that tells the two apart, and it defaults
            // to the owner for every request written before this existed.
            || (resource.data.get('type', '') == 'return'
                && resource.data.get('openedBy', 'owner') == 'holder'
                && resource.data.get('holderId', '') == uid());
      }

      // A verdict is not the applicant's to write. Two other rules read this
      // status back and trust it — the membership write and the book a joiner
      // brings — so a subject who could stamp their own request 'approved'
      // would be a way into any community without an admin ever seeing it.
      // Cancelling, and the pickup lane's own 'fulfilled', stay theirs.
      function decidesOwnRequest() {
        return request.resource.data.status == 'approved'
            || request.resource.data.status == 'rejected';
      }

      allow delete: if false;
    }

    // ═══ phoneVerifications ═══
    //
    // One document per attempt to prove a phone number, keyed by the token that
    // travels in the Telegram deep link (see firebase/phoneVerify.js).
    //
    // Everything about this collection follows from one fact: the client cannot
    // be trusted about phone numbers, because it is the party being checked. So
    // it may say what it *claims* — that is what a pending attempt is — and it
    // may give up. It may not resolve one. The bot does that with the Admin SDK,
    // which bypasses these rules, after comparing the claim against the number
    // on the contact card Telegram vouches for.
    //
    // Reading its own attempt is what the waiting screen is subscribed to: the
    // client watches this document and finishes the moment the bot stamps it.
    //
    // Reads are self-only and by id: the token is not a secret worth much (it
    // buys nothing without a message from the right number) but an attempt names
    // a member and a number, and neither is anybody else's business. There is no
    // `list` at all — the client already knows its own token.

    match /phoneVerifications/{token} {
      allow get: if signedIn() && resource.data.userId == uid();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.channel == 'telegram'
        // A window the client cannot widen. The bot checks its own clock too;
        // this stops an attempt being written that is redeemable for a year.
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt <= request.time.toMillis() + 3600000;

      // Abandoning is the only transition a client may make, and only on a
      // pending attempt of its own — reopening a resolved one would hand back a
      // token the bot has already answered for.
      allow update: if signedIn()
        && resource.data.userId == uid()
        && resource.data.status == 'pending'
        && touchesOnly(['status'].toSet())
        && request.resource.data.status == 'cancelled';

      allow delete: if false;
    }

    // ═══ posts ═══
    //
    // Community-scoped both ways: only that community's admin writes them, only
    // its members read them.

    match /posts/{postId} {
      // Two ways to be readable, and a query has to name one of them:
      //
      //   isPublic == true      — the discovery feed on Home. The flag lives on
      //                           the post, not on the community, because a rule
      //                           that had to `get()` the community would do it
      //                           once per document returned and blow the
      //                           per-query document-access limit on any real
      //                           page of results.
      //   communityId == mine   — the member's own noticeboard, unchanged.
      //
      // A post written before the flag existed has no `isPublic`, which reads as
      // false here: old posts stay members-only until they are backfilled, which
      // is the safe direction for a field that controls who can see something.
      allow get, list: if signedIn()
        && (resource.data.isPublic == true
            || resource.data.communityId == myCommunity());

      // A post is its text. `title` used to be the required field and is kept
      // only because posts written under that rule still carry one — nothing
      // creates it any more, and the screen that writes posts asks for one
      // thing, which is what a noticeboard entry actually is.
      allow create: if isAdminOf(request.resource.data.communityId)
        && request.resource.data.authorId == uid()
        && request.resource.data.isPublic is bool
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0;

      allow update: if postAuthorEdit() || postVisibilitySync() || postLikeRollup();

      // Only the author takes their own notice down. A community admin is the
      // author of everything they posted, so this is not narrower in practice —
      // it is narrower in what it permits: no admin reaching into a post
      // somebody else wrote, including a predecessor's.
      allow delete: if isAdminOf(resource.data.communityId)
        && resource.data.authorId == uid();
    }

    // An author fixing their own notice. `touchesOnly` is what keeps this from
    // becoming a way to re-attribute a post, move it to another community, or
    // publish it: everything that identifies the post stays put, and the text
    // may be corrected but not emptied — the create rule refuses a blank one, so
    // an edit that could blank it would be a hole in the same rule.
    function postAuthorEdit() {
      return isAdminOf(resource.data.communityId)
        && resource.data.authorId == uid()
        && touchesOnly(['title', 'body'].toSet())
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0;
    }

    // Re-stamping visibility when the community's privacy changes. The admin of
    // the owning community may set this flag and nothing else — which is the
    // same power they already have by flipping the community itself, so tying it
    // to a get() of the community would be enforcement in appearance only, and
    // would spend a document read per post in the batch.
    function postVisibilitySync() {
      return isAdminOf(resource.data.communityId)
        && touchesOnly(['isPublic'].toSet())
        && request.resource.data.isPublic is bool;
    }

    // A like, counted on the post itself. Anyone who can *read* the post can
    // like it — the same reach the feed has — and the counter may only move by
    // one, in either direction, and never below zero. That bound is what keeps
    // this from being a way to write an arbitrary number onto somebody else's
    // post: which of the two directions a caller is entitled to is held on
    // their own profile, in `likedPostIds`, where only they can write it.
    function postLikeRollup() {
      return signedIn()
        && (resource.data.isPublic == true || resource.data.communityId == myCommunity())
        && touchesOnly(['likeCount'].toSet())
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
            || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1);
    }

    // ═══ notifications ═══
    //
    // The one collection that is strictly recipient-only: these documents carry
    // pickupCode and returnCode, and a notification list is the closest thing
    // this app has to a private inbox.
    //
    // Creation, by contrast, is open to any signed-in user — and has to be. A
    // member notifies the admin to ask to join or leave; a would-be reader
    // notifies whoever is holding a book. Neither is an admin action.

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.recipientId == uid();

      allow create: if signedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.title is string
        && request.resource.data.read == false
        && (!('senderId' in request.resource.data)
            || request.resource.data.senderId == uid());

      allow update: if signedIn()
        && resource.data.recipientId == uid()
        && frozen(['recipientId', 'senderId', 'createdAt'].toSet());

      allow delete: if signedIn() && resource.data.recipientId == uid();
    }

    // ═══ chats ═══
    //
    // A conversation between exactly two people. Its id is the two uids sorted
    // and joined by '__', and that is enforced here rather than trusted from the
    // client — it is what makes a second thread for the same pair impossible to
    // create, and it makes "am I in this conversation?" a question the id itself
    // answers.
    //
    // That last part is deliberate and load-bearing: every rule on the messages
    // subcollection below reads membership out of the *path*, so sending or
    // reading a message costs no get() at all. The alternative — get() the chat
    // document on every message — would be one billed read per message written
    // and, worse, would not work: a batch that creates the conversation and its
    // first message in one commit cannot see its own uncommitted chat document.
    //
    // Nothing is lost by trusting the id. Only the two uids named in it can read
    // or write anything beneath it, so the worst a caller can do by inventing a
    // path is talk to themselves in a thread with no document and no list entry.

    function chatPair(chatId) { return chatId.split('__'); }

    // Named in the id, and the id names exactly two people. The size check is
    // what stops 'a__b__c' from being a three-way thread nobody can moderate.
    function inChatId(chatId) {
      return signedIn()
        && chatPair(chatId).size() == 2
        && uid() in chatPair(chatId);
    }

    /** The member who is not the caller. */
    function otherMember(members) {
      return members[0] == uid() ? members[1] : members[0];
    }

    // The pair, the id and the document all saying the same thing. `<` rather
    // than `!=` gives the sort *and* refuses a self-chat in one comparison: two
    // equal ids cannot satisfy it.
    function wellFormedChat(chatId) {
      let members = request.resource.data.memberIds;
      return members is list
        && members.size() == 2
        && members[0] is string && members[1] is string
        && members[0] < members[1]
        && chatId == members[0] + '__' + members[1]
        && uid() in members
        && request.resource.data.keys().hasOnly(
             ['memberIds', 'lastMessage', 'updatedAt', 'unread'])
        && request.resource.data.updatedAt == request.time;
    }

    // The preview on the conversation row. Written by whoever just spoke, and
    // stamped by the server — a client-chosen time would let one member pin
    // their thread to the top of the other's list for ever.
    function freshPreview() {
      return request.resource.data.lastMessage.senderId == uid()
        && request.resource.data.lastMessage.text is string
        && request.resource.data.lastMessage.text.size() > 0
        && request.resource.data.lastMessage.at == request.time;
    }

    // Sending: the preview and the stamp move, the recipient's counter goes up
    // by exactly one, and the sender's own goes to zero — they have read their
    // own thread by definition. Bounded to +1 so a single write cannot inflate
    // somebody's badge to a thousand.
    function chatSend() {
      let other = otherMember(resource.data.memberIds);
      return touchesOnly(['lastMessage', 'updatedAt', 'unread'].toSet())
        && request.resource.data.updatedAt == request.time
        && freshPreview()
        && request.resource.data.unread.get(uid(), 0) == 0
        && request.resource.data.unread.get(other, 0) == resource.data.unread.get(other, 0) + 1;
    }

    // Opening the thread: a member zeroes their own counter, stamps their own
    // read watermark, and may touch neither of the other's — reading your
    // messages is not a way to clear somebody else's badge, and it is certainly
    // not a way to claim they read yours.
    //
    // `== request.time` is what makes a watermark trustworthy. A client-chosen
    // value could be rewound to un-read a message, or pushed into the future to
    // mark as read things that have not been sent yet; the server's own clock
    // can do neither, and only ever moves forward.
    // The watermark is optional here: clearing the badge without stamping one
    // is a legitimate write, and demanding both would reject it. What is not
    // optional is that a stamped mark be the caller's own and be the server's
    // clock — hence the implication rather than a plain conjunction.
    function chatMarkRead() {
      let other = otherMember(resource.data.memberIds);
      return touchesOnly(['unread', 'readAt'].toSet())
        && request.resource.data.unread.get(uid(), 0) == 0
        && request.resource.data.unread.get(other, 0) == resource.data.unread.get(other, 0)
        && (!changed().hasAny(['readAt'].toSet()) || ownWatermarkOnly('readAt', other));
    }

    // The second tick, written by the device that received the message — the
    // only party in a position to say it arrived. Nothing else may move: a
    // delivery receipt that could also touch the counter or the preview would
    // be a way to edit somebody else's conversation while acknowledging it.
    function chatMarkDelivered() {
      return touchesOnly(['deliveredAt'].toSet())
        && ownWatermarkOnly('deliveredAt', otherMember(resource.data.memberIds));
    }

    /**
     * My mark is the server's clock; theirs is exactly what it already was.
     *
     * Every lookup goes through `get` with a default. Indexing a map that the
     * write does not carry — a chat with no receipts on it yet, or a member
     * clearing their badge without stamping — is not "false" in this language,
     * it is an evaluation error that denies the write for the wrong reason.
     */
    function ownWatermarkOnly(field, other) {
      return request.resource.data.get(field, {}).get(uid(), null) == request.time
        && request.resource.data.get(field, {}).get(other, null)
           == resource.data.get(field, {}).get(other, null);
    }

    match /chats/{chatId} {
      // Membership, and a query has to name it: the app lists chats with
      // `where('memberIds', 'array-contains', uid)`, which is this rule stated
      // as a filter.
      allow get, list: if signedIn() && uid() in resource.data.memberIds;

      // A conversation is born from its first message, so a create is one:
      // the recipient's counter is exactly one, and the sender is the speaker.
      allow create: if signedIn()
        && wellFormedChat(chatId)
        && freshPreview()
        && request.resource.data.unread.get(uid(), 0) == 0
        && request.resource.data.unread.get(otherMember(request.resource.data.memberIds), 0) == 1;

      allow update: if inChatId(chatId)
        && uid() in resource.data.memberIds
        && frozen(['memberIds'].toSet())
        && (chatSend() || chatMarkRead() || chatMarkDelivered());

      // No delete. One member removing the conversation would remove it for
      // both, and there is no such button in the app — a thread that needs to
      // go needs a moderation story this project does not have yet.
    }

    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if inChatId(chatId);

      allow create: if inChatId(chatId)
        && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
        && request.resource.data.senderId == uid()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;

      // Said is said. A message cannot be edited into something the other
      // person never received, and cannot be taken back after they have read
      // it — which is also why the unread counter can be a plain number rather
      // than something that has to be recomputed when history changes.
      allow update, delete: if false;
    }

    // Everything not matched above is already denied — this only says so out
    // loud. It grants nothing: `allow` is additive, and this one never fires.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
