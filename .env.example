VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Phone verification bots (src/firebase/phoneVerify.js).
#
# A member proves their number by messaging one of these, and the webhook in
# functions/ writes the profile once it sees the message arrive from that very
# number. Leave one blank and the app simply does not offer that channel.
#
# WhatsApp: the business number readers message, digits only or E.164 — it goes
# into a wa.me link.
VITE_WHATSAPP_BOT_PHONE=
# Telegram: the bot's username, with or without the leading @.
VITE_TELEGRAM_BOT=
