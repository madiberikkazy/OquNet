VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Telegram bot that verifies phone numbers, with or without the @.
# Vite bakes this into the bundle at BUILD time, so setting it on Vercel needs a
# redeploy to take effect — an unset one makes the verify screen say so rather
# than fail quietly. The bot itself is server/, deployed separately.
VITE_TELEGRAM_BOT=

# Where product analytics events are POSTed, as batches of
# {events:[{name, ts, sessionId, userId, props}]}. Unset — the default — turns
# the whole thing off: events are mirrored to the console in dev and dropped
# everywhere else, and nothing leaves the device. See src/utils/analytics.js.
VITE_ANALYTICS_ENDPOINT=

# ── Web Push ────────────────────────────────────────────────────────────────
# Notifications that arrive while the app is closed. Generate the key pair once
# with `npx web-push generate-vapid-keys`: the PUBLIC half goes here, the
# private half goes to the server as VAPID_PRIVATE_KEY (see server/README.md).
# VITE_PUSH_SERVER is the origin of that server — the same process that handles
# phone verification. With either unset the app reports push as unsupported and
# the settings toggle stays off; nothing else changes.
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_SERVER=
