{
  "_comment": [
    "Composite indexes for OquNet. Every index here backs a specific query in",
    "src/firebase/firestore.js; nothing is speculative. Deploy with:",
    "  firebase deploy --only firestore:indexes",
    "",
    "Firestore builds these by scanning the collection, so they take MINUTES to",
    "become ready, and the affected queries fail with FAILED_PRECONDITION until",
    "they do. Deploy indexes BEFORE deploying the app that needs them.",
    "",
    "Queries absent from this file on purpose: any query made only of equality",
    "filters with no orderBy — listBooksHeldBy, listBooksOwnedBy,",
    "getPickupRequest, getActiveBorrowingByBook, listJoinRequests and friends.",
    "Firestore serves those by merging the single-field indexes it maintains",
    "automatically, so a composite would cost writes and buy nothing. Same for",
    "the prefix scans in searchUsers/searchCommunities: a range plus an orderBy",
    "on that same single field is a single-field index."
  ],
  "indexes": [
    {
      "_comment": "listBooks (unfiltered) and listNewBooks (createdAt range + same-field orderBy).",
      "collectionGroup": "books",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "communityId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listBooks + status.",
      "collectionGroup": "books",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "communityId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listBooks + genres (an `in`, executed as ranges over this index).",
      "collectionGroup": "books",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "communityId", "order": "ASCENDING" },
        { "fieldPath": "genre", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listBooks + status + genres.",
      "collectionGroup": "books",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "communityId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "genre", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listBooks + search.",
      "collectionGroup": "books",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "communityId", "order": "ASCENDING" },
        { "fieldPath": "searchPrefixes", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listBooks + status + search.",
      "collectionGroup": "books",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "communityId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "searchPrefixes", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listBooks + genres + search.",
      "collectionGroup": "books",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "communityId", "order": "ASCENDING" },
        { "fieldPath": "genre", "order": "ASCENDING" },
        { "fieldPath": "searchPrefixes", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listBooks + status + genres + search — every filter at once.",
      "collectionGroup": "books",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "communityId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "genre", "order": "ASCENDING" },
        { "fieldPath": "searchPrefixes", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listPostsByCommunity.",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "communityId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listPublicPosts — the discovery half of the Home feed.",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listNotifications.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "recipientId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "listReadingSessions — a reader's own sittings, newest first.",
      "collectionGroup": "readingSessions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "startedAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "getLastCompletedBorrowingByBook.",
      "collectionGroup": "borrowings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "bookId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
