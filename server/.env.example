# Firebase Admin credential — the whole service-account JSON on one line.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# This key can read and write the entire database: it belongs in the host's
# environment settings and nowhere else. Never commit it.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"oqunet-6070b",...}

# ── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Any long random string you invent. Telegram echoes it on every request, and
# the server rejects anything that arrives without it — it is what stops a
# stranger who finds the URL from posting fake updates.
TELEGRAM_WEBHOOK_SECRET=

# ── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# Any string you invent; Meta sends it back once when the callback URL is saved.
WHATSAPP_VERIFY_TOKEN=
# Meta app → Settings → Basic → App secret. Every payload is signed with it.
WHATSAPP_APP_SECRET=
# Optional: a permanent access token, only needed to reply inside WhatsApp.
WHATSAPP_TOKEN=

# Render sets this itself; 8080 is the local default.
PORT=8080
