# Firebase Admin credential — the whole service-account JSON on one line.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# This key can read and write the entire database: it belongs in the host's
# environment settings and nowhere else. Never commit it.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"oqunet-6070b",...}
# Alternative for hosts that mangle quotes: the same JSON, base64-encoded.
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Any long random string you invent — `openssl rand -hex 24` will do. Telegram
# echoes it on every update, and the server refuses anything that arrives
# without it. It must be passed to setWebhook as `secret_token`, which is what
# `npm run set-webhook` does; a webhook registered without it delivers updates
# this server rejects, silently, forever.
TELEGRAM_WEBHOOK_SECRET=

# Only for `npm run set-webhook`: where this server is reachable.
PUBLIC_URL=https://oqunet.onrender.com

# Render sets this itself; 8080 is the local default.
PORT=8080

# ── Web Push ────────────────────────────────────────────────────────────────
# The private half of the VAPID key pair; the public half goes to the app as
# VITE_VAPID_PUBLIC_KEY. Generate both once:
#
#   npx web-push generate-vapid-keys
#
# Rotating these invalidates every existing subscription — every device has to
# re-register — so generate once and keep them. With either half unset the push
# routes answer 503 and nothing is ever delivered; everything else still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real inbox. The VAPID spec requires a contact for the push service to use
# when this application starts misbehaving.
VAPID_SUBJECT=mailto:support@oqunet.app

# The origin the app is served from, e.g. https://oqunet.vercel.app. Sets the
# CORS header on /push/* only. Deliberately one origin and not `*`: these
# routes take a Firebase ID token. Unset means same-origin only.
APP_ORIGIN=
