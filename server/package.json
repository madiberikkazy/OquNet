{
  "name": "oqunet-verify-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram phone-verification webhook — the only writer of a verified number.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
